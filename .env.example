NODE_ENV=local
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=local_db

# Required. No default. A number from 0 to 100. Decimals are allowed.
PASS_PERCENTAGE=40

# Required. No default. Format YYYY-YY, where the second year is the first + 1.
ACADEMIC_YEAR=2026-27
